{
  "uid": "linewarmer-app-metrics",
  "title": "Linewarmer - Application Metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(target_info, deployment_environment)", "refId": "environment" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "version",
        "label": "Deployed version",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(target_info{deployment_environment=~\"$environment\"}, service_version)",
          "refId": "version"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 5,
      "title": "Interview Rooms Created (total)",
      "description": "Cumulative count of interview rooms (sessions) created, for the selected environment/version.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(interview_rooms_created_total{deployment_environment=~\"$environment\", service_version=~\"$version\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Canvas Elements Created (total)",
      "description": "Cumulative count of canvas elements created, for the selected environment/version.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(canvas_elements_created_total{deployment_environment=~\"$environment\", service_version=~\"$version\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Canvas Component Creation Failures (total)",
      "description": "Cumulative count of canvas component creation attempts that failed validation, for the selected environment/version.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "red" }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(canvas_component_creation_failures_total{deployment_environment=~\"$environment\", service_version=~\"$version\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Active Interview Participants (current)",
      "description": "Participants currently joined (not yet removed) across matching sessions.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(interview_participants_active{deployment_environment=~\"$environment\", service_version=~\"$version\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 1,
      "title": "Interview Rooms Created",
      "description": "Running total of rooms created over time - a step up each time one is created. (Sparse/manual testing produces a near-invisible rate/sec, hence plotting the raw cumulative count instead.)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(interview_rooms_created_total{deployment_environment=~\"$environment\", service_version=~\"$version\"})",
          "legendFormat": "rooms created"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Interview Participants",
      "description": "Participants currently joined (not yet removed) across matching sessions.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(interview_participants_active{deployment_environment=~\"$environment\", service_version=~\"$version\"})",
          "legendFormat": "active participants"
        }
      ]
    },
    {
      "id": 3,
      "title": "Canvas Elements Created",
      "description": "Running total of canvas elements (nodes, stickies, text, strokes, connectors) created over time.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "showLegend": true, "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(canvas_elements_created_total{deployment_environment=~\"$environment\", service_version=~\"$version\"})",
          "legendFormat": "elements created"
        }
      ]
    },
    {
      "id": 4,
      "title": "Canvas Component Creation Failures",
      "description": "Running total of canvas component (element) creation attempts that failed validation.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": { "legend": { "showLegend": true, "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(canvas_component_creation_failures_total{deployment_environment=~\"$environment\", service_version=~\"$version\"})",
          "legendFormat": "creation failures"
        }
      ]
    }
  ]
}
